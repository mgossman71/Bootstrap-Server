# Copy this to .env and uncomment/set values as needed.
# docker-compose.yml reads variables from this file automatically.

# The LAN IP (or hostname) your VMs will use to reach this server.
# This gets injected into all copy/paste commands on the dashboard.
#
# Find your Mac's real IP: ip get | grep inet   (macOS)  or  hostname -I  (Linux)
# Make sure this is the IP your LXC/VMs can actually reach!
#
# BOOTSTRAP_PUBLIC_URL=http://192.168.1.50:9090
